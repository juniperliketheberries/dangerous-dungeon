.bar {
    flex-shrink: 0;
    flex-grow: 0;
    width: 80px;
    height: 8px;
}

.bar-container {
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
}

.bar-end {
    flex-shrink: 0;
    flex-grow: 0;
    width: 9px;
}

.bar-center {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
}
