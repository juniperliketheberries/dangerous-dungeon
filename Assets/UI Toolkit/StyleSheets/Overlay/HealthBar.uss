.bar {
    flex-shrink: 0;
    flex-grow: 0;
    width: 120px;
    height: 18px;
}

.bar-container {
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.bar-end {
    flex-shrink: 0;
    flex-grow: 0;
    width: 9px;
    height: 18px;
}

.bar-center {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 18px;
}
